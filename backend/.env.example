NODE_ENV=development
PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/wcase
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1h
# Required separately in production. Used for short-lived private media links.
MEDIA_SIGNING_SECRET=replace-with-a-different-random-secret-at-least-32-characters-long
MEDIA_URL_TTL_SECONDS=3600
MEDIA_STORAGE_PROVIDER=local
# Required when MEDIA_STORAGE_PROVIDER=cloudinary. Keep the API secret server-side only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FRONTEND_URL=http://localhost:5173
# Required explicitly in production. Use comma-separated exact origins; never use *.
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0

# Brevo transactional email over HTTPS. Use a verified sender and a dedicated API key.
EMAIL_USER=your-verified-sender@example.com
BREVO_API_KEY=
EMAIL_FROM_NAME=WCase
# Public absolute HTTPS URL for the logo displayed by email clients.
APP_LOGO_URL=https://your-domain.example/wcase-logo.png
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
# Required separately in production; JWT_SECRET is used as a development fallback.
OTP_HASH_SECRET=replace-with-a-different-random-secret-at-least-32-characters-long
